<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expense Tracker - Gestão Financeira</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #ffffff; color: #1c1917; }
        .input-field {
            border-bottom: 1px solid #e7e5e4;
            transition: border-color 0.2s;
        }
        .input-field:focus {
            border-bottom-color: #c2410c;
            outline: none;
        }
    </style>
</head>
<body class="min-h-screen">

    <!-- LOGIN SCREEN -->
    <div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-white transition-all duration-500">
        <div class="max-w-sm w-full p-8">
            <div class="mb-10 text-center">
                <h1 class="text-3xl font-light tracking-tight text-stone-900">Entrar</h1>
                <p class="text-stone-500 text-sm mt-2">Aceda à sua conta financeira</p>
            </div>

            <form id="login-form" class="space-y-6">
                <div>
                    <input type="email" id="login-email" placeholder="E-mail"
                        class="w-full py-3 px-0 bg-transparent border-b border-stone-200 input-field placeholder:text-stone-300" required>
                </div>
                <div>
                    <input type="password" id="login-password" placeholder="Senha"
                        class="w-full py-3 px-0 bg-transparent border-b border-stone-200 input-field placeholder:text-stone-300" required>
                </div>
                <button type="submit"
                    class="w-full py-4 bg-stone-900 hover:bg-stone-800 text-white rounded-lg font-medium transition-all active:scale-95">
                    Entrar
                </button>
            </form>
        </div>
    </div>

    <!-- MAIN APP -->
    <div id="app-screen" class="hidden transition-all duration-500">
        <nav class="border-b border-stone-100 px-6 py-5 flex justify-between items-center bg-white">
            <span class="font-medium text-stone-900 tracking-tight">ExpenseTracker</span>
            <div class="flex items-center gap-6">
                <select id="currency-selector" class="bg-transparent text-sm text-stone-500 outline-none cursor-pointer hover:text-stone-800 transition-colors">
                    <option value="MYR">MYR (Ringgit)</option>
                    <option value="MZN">MZN (Metical)</option>
                </select>
                <button id="logout-btn" class="text-stone-400 hover:text-stone-900 transition-colors text-sm font-medium">Sair</button>
            </div>
        </nav>

        <main class="max-w-6xl mx-auto p-6 grid grid-cols-1 lg:grid-cols-12 gap-12">

            <!-- Entry Column -->
            <div class="lg:col-span-4 space-y-10">
                <div class="space-y-2">
                    <h2 class="text-xs font-semibold text-stone-400 uppercase tracking-widest">Saldo Disponível</h2>
                    <div class="flex items-baseline gap-2">
                        <span id="budget-total" class="text-4xl font-light text-stone-900">0,00</span>
                        <span class="currency-label text-stone-400 font-medium">MYR</span>
                    </div>
                    <div class="h-1 w-full bg-stone-100 rounded-full overflow-hidden mt-4">
                        <div id="budget-bar" class="h-full transition-all duration-700 bg-stone-900" style="width: 0%"></div>
                    </div>
                </div>

                <div class="space-y-6">
                    <h2 class="text-xs font-semibold text-stone-400 uppercase tracking-widest">Novo Gasto</h2>
                    <form id="expense-form" class="space-y-6">
                        <div class="relative">
                            <input type="number" id="amount" step="0.01" placeholder="Valor"
                                class="w-full text-2xl font-light py-3 px-0 bg-transparent border-b border-stone-200 input-field placeholder:text-stone-300" required>
                        </div>
                        <input type="text" id="description" placeholder="Descrição da despesa"
                            class="w-full py-3 px-0 bg-transparent border-b border-stone-200 input-field placeholder:text-stone-300" required>

                        <select id="category" class="w-full py-3 px-0 bg-transparent border-b border-stone-200 input-field text-stone-600 outline-none cursor-pointer">
                            <option value="Alimentação">Alimentação</option>
                            <option value="Transporte">Transporte</option>
                            <option value="Lazer">Lazer</option>
                            <option value="Saúde">Saúde</option>
                            <option value="Outros">Outros</option>
                        </select>

                        <button type="submit" id="submit-btn"
                            class="w-full py-4 bg-stone-900 hover:bg-stone-800 text-white rounded-lg font-medium transition-all active:scale-95">
                            <span id="btn-text">Adicionar Gasto</span>
                        </button>
                        <div id="error-msg" class="hidden text-center text-red-500 text-xs">
                            Preencha todos os campos corretamente.
                        </div>
                    </form>
                </div>
            </div>

            <!-- History Column -->
            <div class="lg:col-span-8">
                <div class="flex justify-between items-center mb-8">
                    <h2 class="text-xl font-light text-stone-900">Histórico Detalhado</h2>
                    <span class="text-xs text-stone-400" id="tx-count">0 transações</span>
                </div>

                <div id="transactions-list" class="divide-y divide-stone-100">
                    <!-- Transactions injected here -->
                </div>

                <div id="empty-state" class="hidden py-20 text-center">
                    <p class="text-stone-400 font-light">Nenhum gasto registado.</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        const API_BASE_URL = 'https://seu-app.herokuapp.com';

        const state = {
            user: null,
            token: localStorage.getItem('token') || null,
            currency: 'MYR',
            budgetLimit: 5000,
            spentAmount: 0,
            transactions: []
        };

        const screens = { login: document.getElementById('login-screen'), app: document.getElementById('app-screen') };
        const forms = { login: document.getElementById('login-form'), expense: document.getElementById('expense-form') };
        const ui = {
            budgetTotal: document.getElementById('budget-total'),
            budgetBar: document.getElementById('budget-bar'),
            transactionsList: document.getElementById('transactions-list'),
            emptyState: document.getElementById('empty-state'),
            submitBtn: document.getElementById('submit-btn'),
            btnText: document.getElementById('btn-text'),
            errorMsg: document.getElementById('error-msg'),
            currencyLabels: document.querySelectorAll('.currency-label'),
            txCount: document.getElementById('tx-count')
        };

        async function handleLogin(e) {
            e.preventDefault();
            await new Promise(r => setTimeout(r, 800));
            localStorage.setItem('token', 'mock-token');
            state.token = 'mock-token';
            showApp();
        }

        function handleLogout() {
            localStorage.removeItem('token');
            state.token = null;
            showLogin();
        }

        function showApp() {
            screens.login.classList.add('hidden');
            screens.app.classList.remove('hidden');
            initApp();
        }

        function showLogin() {
            screens.app.classList.add('hidden');
            screens.login.classList.remove('hidden');
        }

        async function initApp() {
            updateBudgetUI();
            await fetchTransactions();
        }

        async function fetchTransactions() {
            // Simulação de dados iniciais
            state.transactions = [
                { id: 1, description: 'Almoço Trabalho', amount: 15.00, category: 'Alimentação', date: '2023-10-20' },
                { id: 2, description: 'Uber', amount: 12.50, category: 'Transporte', date: '2023-10-21' },
            ];
            calculateTotals();
            renderTransactions();
        }

        function calculateTotals() {
            state.spentAmount = state.transactions.reduce((acc, t) => acc + t.amount, 0);
            updateBudgetUI();
        }

        function updateBudgetUI() {
            const percent = (state.spentAmount / state.budgetLimit) * 100;
            const available = state.budgetLimit - state.spentAmount;

            ui.budgetTotal.innerText = available.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            ui.budgetBar.style.width = `${Math.min(percent, 100)}%`;

            ui.currencyLabels.forEach(el => el.innerText = state.currency);
        }

        function renderTransactions() {
            ui.txCount.innerText = `${state.transactions.length} transações`;
            if (state.transactions.length === 0) {
                ui.emptyState.classList.remove('hidden');
                ui.transactionsList.innerHTML = '';
                return;
            }

            ui.emptyState.classList.add('hidden');
            ui.transactionsList.innerHTML = state.transactions.map(t => `
                <div class="py-5 flex justify-between items-center group">
                    <div class="flex flex-col">
                        <span class="text-sm font-medium text-stone-800">${t.description}</span>
                        <span class="text-xs text-stone-400">${t.date} • ${t.category}</span>
                    </div>
                    <div class="flex items-center gap-6">
                        <span class="text-sm font-medium text-stone-900">
                            - ${t.amount.toLocaleString('en-US', { minimumFractionDigits: 2 })} ${state.currency}
                        </span>
                        <button onclick="deleteTransaction(${t.id})" class="text-xs text-stone-300 hover:text-red-500 transition-colors">Remover</button>
                    </div>
                </div>
            `).join('');
        }

        async function handleExpenseSubmit(e) {
            e.preventDefault();
            const amount = parseFloat(document.getElementById('amount').value);
            const description = document.getElementById('description').value;
            const category = document.getElementById('category').value;

            ui.errorMsg.classList.add('hidden');
            ui.submitBtn.disabled = true;
            ui.btnText.innerText = 'A processar...';

            try {
                await new Promise(r => setTimeout(r, 600));

                const newTx = {
                    id: Date.now(),
                    description,
                    amount,
                    category,
                    date: new Date().toISOString().split('T')[0]
                };

                state.transactions.unshift(newTx);
                calculateTotals();
                renderTransactions();

                ui.btnText.innerText = 'Sucesso!';
                ui.submitBtn.classList.replace('bg-stone-900', 'bg-green-600');

                setTimeout(() => {
                    ui.btnText.innerText = 'Adicionar Gasto';
                    ui.submitBtn.classList.replace('bg-green-600', 'bg-stone-900');
                    ui.submitBtn.disabled = false;
                    forms.expense.reset();
                }, 1500);

            } catch (err) {
                ui.errorMsg.classList.remove('hidden');
                ui.submitBtn.disabled = false;
                ui.btnText.innerText = 'Erro ao salvar';
            }
        }

        window.deleteTransaction = async (id) => {
            // Simulação de DELETE no backend
            await new Promise(r => setTimeout(r, 300));
            state.transactions = state.transactions.filter(t => t.id !== id);
            calculateTotals();
            renderTransactions();
        };

        // Eventos
        forms.login.onsubmit = handleLogin;
        forms.expense.onsubmit = handleExpenseSubmit;
        document.getElementById('logout-btn').onclick = handleLogout;
        document.getElementById('currency-selector').onchange = (e) => {
            state.currency = e.target.value;
            updateBudgetUI();
            renderTransactions();
        };

        if (state.token) showApp(); else showLogin();
    </script>
</body>
</html>
